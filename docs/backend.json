
{
  "entities": {
    "Member": {
      "title": "Member",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "joined": { "type": "string" },
        "dateOfBirth": { "type": "string", "format": "date" },
        "birthdayKey": { "type": "string", "description": "MMDD index" },
        "societies": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of church societies or groups the member belongs to."
        }
      }
    },
    "SMSWallet": {
      "title": "SMS Wallet",
      "type": "object",
      "properties": {
        "churchId": { "type": "string" },
        "balance": { "type": "number" },
        "reserved": { "type": "number" },
        "totalTopups": { "type": "number" },
        "totalSpent": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "SMSLedger": {
      "title": "SMS Ledger",
      "type": "object",
      "properties": {
        "churchId": { "type": "string" },
        "messageId": { "type": "string" },
        "type": { "type": "string", "enum": ["DEBIT", "REFUND"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["RESERVED", "COMMITTED", "SENT", "FAILED", "REFUNDED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/churches/{churchId}": {
      "description": "Tenant organization settings and configuration."
    },
    "/smsWallets/{churchId}": {
      "schema": "SMSWallet",
      "description": "Transactional source of truth for organization credit balance."
    },
    "/smsLedger/{ledgerId}": {
      "schema": "SMSLedger",
      "description": "Immutable financial audit trail for every SMS movement."
    },
    "/smsLocks/{churchId}": {
      "description": "Distributed locks to prevent parallel processing race conditions."
    },
    "/smsQueue/{messageId}": {
      "description": "Global queue for all outgoing messages."
    },
    "/smsTransactions/{txId}": {
      "description": "Legacy transaction log for top-ups and adjustments."
    }
  }
}
