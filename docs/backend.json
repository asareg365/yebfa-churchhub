
{
  "entities": {
    "Member": {
      "title": "Member",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "joined": { "type": "string" },
        "dateOfBirth": { "type": "string", "format": "date" },
        "birthdayKey": { "type": "string", "description": "MM-DD index" }
      }
    },
    "Visitor": {
      "title": "Visitor",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "visitDate": { "type": "string", "format": "date" },
        "followupSent": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SMSQueue": {
      "title": "SMS Queue",
      "type": "object",
      "properties": {
        "churchId": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "processing", "sent", "failed"] },
        "type": { "type": "string" },
        "cost": { "type": "number" },
        "retryCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "scheduledAt": { "type": "string", "format": "date-time" }
      }
    },
    "SMSWallet": {
      "title": "SMS Wallet",
      "type": "object",
      "properties": {
        "churchId": { "type": "string" },
        "balance": { "type": "number" },
        "totalUsed": { "type": "number" },
        "lastTopupAt": { "type": "string", "format": "date-time" }
      }
    },
    "SMSLog": {
      "title": "SMS Log",
      "type": "object",
      "properties": {
        "churchId": { "type": "string" },
        "memberName": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string" },
        "error": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SMSTransaction": {
      "title": "SMS Transaction",
      "type": "object",
      "properties": {
        "churchId": { "type": "string" },
        "type": { "type": "string", "enum": ["debit", "credit", "topup"] },
        "amount": { "type": "number" },
        "balanceBefore": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/churches/{churchId}": {
      "description": "Tenant organization settings and configuration."
    },
    "/smsWallets/{churchId}": {
      "schema": "SMSWallet",
      "description": "Isolated financial balances for each tenant."
    },
    "/smsQueue/{messageId}": {
      "schema": "SMSQueue",
      "description": "Global queue for all outgoing messages."
    },
    "/churches/{churchId}/members/{memberId}": {
      "schema": "Member"
    },
    "/churches/{churchId}/smsLogs/{logId}": {
      "schema": "SMSLog"
    },
    "/churches/{churchId}/smsTransactions/{txId}": {
      "schema": "SMSTransaction"
    }
  }
}
