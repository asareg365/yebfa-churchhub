{
  "entities": {
    "Member": {
      "title": "Member",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "joined": { "type": "string" },
        "dateOfBirth": { "type": "string", "format": "date" }
      }
    },
    "SMSLog": {
      "title": "SMS Log",
      "type": "object",
      "properties": {
        "memberName": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "failed", "pending", "retrying"] },
        "type": { "type": "string", "enum": ["birthday", "announcement", "test", "reminder"] },
        "retryCount": { "type": "number" },
        "cost": { "type": "number" },
        "error": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "reference": { "type": "string" },
        "status": { "type": "string" },
        "provider": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/churches/{churchId}": {
      "description": "Tenant organization. Admin access restricted to users in adminEmails array."
    },
    "/churches/{churchId}/members/{memberId}": {
      "schema": "Member",
      "description": "Tenant isolated member directory."
    },
    "/churches/{churchId}/smsLogs/{logId}": {
      "schema": "SMSLog",
      "description": "Tenant isolated communication logs with strict ownership rules."
    },
    "/churches/{churchId}/smsTemplates/{templateId}": {
      "description": "Tenant isolated reusable message structures."
    },
    "/churches/{churchId}/attendance/{attendanceId}": {
      "description": "Tenant isolated service attendance records."
    },
    "/churches/{churchId}/finances/{financeId}": {
      "description": "Tenant isolated tithing and offering records."
    },
    "/churches/{churchId}/events/{eventId}": {
      "description": "Tenant isolated event planning."
    },
    "/churches/{churchId}/transactions/{txId}": {
      "schema": "Transaction",
      "description": "Tenant isolated billing history."
    }
  }
}
