
{
  "entities": {
    "Member": {
      "title": "Member",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "joined": { "type": "string" },
        "dateOfBirth": { "type": "string", "format": "date" },
        "birthdayKey": { "type": "string", "description": "MM-DD index" }
      }
    },
    "SMSLog": {
      "title": "SMS Log",
      "type": "object",
      "properties": {
        "memberName": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "failed", "pending", "retrying"] },
        "type": { "type": "string", "enum": ["birthday", "announcement", "test", "reminder", "other"] },
        "retryCount": { "type": "number" },
        "cost": { "type": "number" },
        "error": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SMSTransaction": {
      "title": "SMS Transaction",
      "type": "object",
      "properties": {
        "churchId": { "type": "string" },
        "type": { "type": "string", "enum": ["debit", "credit"] },
        "amount": { "type": "number" },
        "balanceBefore": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/churches/{churchId}": {
      "description": "Tenant organization. Contains organizational settings, plan info, and SMS credits."
    },
    "/churches/{churchId}/members/{memberId}": {
      "schema": "Member",
      "description": "Tenant isolated member directory."
    },
    "/churches/{churchId}/smsLogs/{logId}": {
      "schema": "SMSLog",
      "description": "Tenant isolated communication logs."
    },
    "/churches/{churchId}/smsTransactions/{txId}": {
      "schema": "SMSTransaction",
      "description": "Ledger of credit additions and deductions."
    },
    "/churches/{churchId}/smsTemplates/{templateId}": {
      "description": "Tenant isolated reusable message structures."
    }
  }
}
