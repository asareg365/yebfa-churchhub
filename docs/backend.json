
{
  "entities": {
    "Member": {
      "title": "Member",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "joined": { "type": "string" },
        "dateOfBirth": { "type": "string", "format": "date" },
        "birthdayKey": { "type": "string", "description": "MMDD index" },
        "societies": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of church societies or groups the member belongs to."
        },
        "extendedProfile": {
          "$ref": "#/backend/entities/ExtendedProfile",
          "description": "Optional extended data for churches with the feature enabled."
        },
        "profileStatus": {
          "type": "string",
          "enum": ["Complete", "Incomplete", "Not Started"],
          "description": "Indicates the status of the extended profile data completion."
        }
      }
    },
    "ExtendedProfile": {
      "title": "Extended Profile",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "otherNames": { "type": "string" },
        "lastName": { "type": "string" },
        "placeOfBirth": { "type": "string" },
        "maritalStatus": { 
          "type": "string",
          "enum": ["Single", "Married", "Divorced", "Widowed", "Separated", "Other", "Prefer not to say"]
        },
        "educationLevel": {
          "type": "string",
          "enum": ["No formal education", "Primary", "Junior High School", "Senior High School", "Vocational/Technical", "Certificate", "Diploma", "Bachelor's Degree", "Master's Degree", "Doctorate", "Other"]
        },
        "baptism": {
          "type": "object",
          "properties": {
            "baptised": { "type": "boolean" },
            "date": { "type": "string", "format": "date" }
          }
        },
        "confirmation": {
          "type": "object",
          "properties": {
            "confirmed": { "type": "boolean" },
            "place": { "type": "string" },
            "date": { "type": "string", "format": "date" }
          }
        }
      }
    },
    "Church": {
      "title": "Church",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "settings": {
          "type": "object",
          "properties": {
            "extendedProfile": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "configVersion": { "type": "number" },
                "requiredFields": { "type": "array", "items": { "type": "string" } },
                "showInRegistration": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "WelfareMember": {
      "title": "Welfare Member",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "needs": { "type": "string" },
        "photo": { "type": "string" },
        "totalContributions": { "type": "number" },
        "totalBenefits": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "WelfareTransaction": {
      "title": "Welfare Transaction",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["CONTRIBUTION", "BENEFIT"] },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "recordedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SMSLedger": {
      "title": "SMS Ledger",
      "type": "object",
      "properties": {
        "churchId": { "type": "string" },
        "messageId": { "type": "string" },
        "type": { "type": "string", "enum": ["DEBIT", "REFUND"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["RESERVED", "COMMITTED", "SENT", "FAILED", "REFUNDED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/churches/{churchId}": {
      "description": "Tenant organization settings and configuration. Now includes integrated SMS credit wallet and extended profile configuration."
    },
    "/churches/{churchId}/welfare/{memberId}": {
      "schema": "WelfareMember",
      "description": "Dedicated subcollection for welfare support tracking."
    },
    "/churches/{churchId}/welfare/{memberId}/transactions/{txId}": {
      "schema": "WelfareTransaction",
      "description": "Sub-ledger for individual welfare account activity."
    },
    "/smsLedger/{ledgerId}": {
      "schema": "SMSLedger",
      "description": "Immutable financial audit trail for every SMS movement."
    },
    "/smsLocks/{churchId}": {
      "description": "Distributed locks to prevent parallel processing race conditions."
    },
    "/smsQueue/{messageId}": {
      "description": "Global queue for all outgoing messages."
    }
  }
}
