
{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "A member of the church congregation.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "department": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Probation"] },
        "joined": { "type": "string", "format": "date" },
        "dateOfBirth": { "type": "string", "format": "date" },
        "phone": { "type": "string" },
        "photo": { "type": "string" }
      },
      "required": ["name", "department", "status"]
    },
    "SMSLog": {
      "title": "SMS Log",
      "description": "Record of a sent or failed SMS communication.",
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "failed", "pending"] },
        "type": { "type": "string", "enum": ["birthday", "announcement", "test", "other"] },
        "memberName": { "type": "string" },
        "memberId": { "type": "string" },
        "error": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SMSTemplate": {
      "title": "SMS Template",
      "description": "Reusable SMS message structure.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Attendance": {
      "title": "Attendance",
      "description": "A record of service attendance.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "count": { "type": "number" },
        "serviceName": { "type": "string" }
      },
      "required": ["date", "count"]
    },
    "Finance": {
      "title": "Finance",
      "description": "A financial transaction record.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["Tithe", "Offering", "Donation", "Expenditure"] },
        "method": { "type": "string" }
      },
      "required": ["date", "amount", "type"]
    },
    "Event": {
      "title": "Event",
      "description": "A church event or activity.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string" },
        "registrations": { "type": "number" }
      },
      "required": ["title", "date"]
    },
    "Church": {
      "title": "Church",
      "description": "A registered church on the platform.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "adminEmail": { "type": "string" },
        "adminEmails": { 
          "type": "array", 
          "items": { "type": "string" }
        },
        "enabledModules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "plan": { "type": "string", "enum": ["Starter", "Growth", "Premium"] },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Suspended"] },
        "mustChangePassword": { "type": "boolean" },
        "settings": {
          "type": "object",
          "properties": {
            "birthdaySmsEnabled": { "type": "boolean" },
            "lowCreditAlertEnabled": { "type": "boolean" },
            "dailyReportsEnabled": { "type": "boolean" },
            "senderId": { "type": "string" }
          }
        },
        "registeredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "adminEmail", "plan", "status"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/churches/{churchId}": {
      "schema": "Church",
      "description": "Collection of all registered churches."
    },
    "/churches/{churchId}/members/{memberId}": {
      "schema": "Member",
      "description": "Isolated collection of church members per tenant."
    },
    "/churches/{churchId}/smsLogs/{logId}": {
      "schema": "SMSLog",
      "description": "Isolated logs of SMS sent by the tenant."
    },
    "/churches/{churchId}/smsTemplates/{templateId}": {
      "schema": "SMSTemplate",
      "description": "Isolated message templates per tenant."
    },
    "/churches/{churchId}/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Isolated collection of attendance records per tenant."
    },
    "/churches/{churchId}/finances/{financeId}": {
      "schema": "Finance",
      "description": "Isolated collection of financial records per tenant."
    },
    "/churches/{churchId}/events/{eventId}": {
      "schema": "Event",
      "description": "Isolated collection of church events per tenant."
    }
  }
}
