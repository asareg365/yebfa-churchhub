{
  "entities": {
    "Member": {
      "title": "Member",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "joined": { "type": "string" }
      }
    },
    "SMSLog": {
      "title": "SMS Log",
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "retryCount": { "type": "number" },
        "cost": { "type": "number" }
      }
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "reference": { "type": "string" },
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/churches/{churchId}": {
      "description": "Tenant isolation: Read/Write allowed if user email in adminEmails array."
    },
    "/churches/{churchId}/members/{memberId}": {
      "description": "Tenant isolated members."
    },
    "/churches/{churchId}/smsLogs/{logId}": {
      "description": "Tenant isolated SMS logs."
    },
    "/churches/{churchId}/smsTemplates/{templateId}": {
      "description": "Tenant isolated templates."
    },
    "/churches/{churchId}/attendance/{attendanceId}": {
      "description": "Tenant isolated attendance."
    },
    "/churches/{churchId}/finances/{financeId}": {
      "description": "Tenant isolated finances."
    },
    "/churches/{churchId}/events/{eventId}": {
      "description": "Tenant isolated events."
    },
    "/churches/{churchId}/transactions/{txId}": {
      "description": "Tenant isolated billing transactions."
    }
  }
}
