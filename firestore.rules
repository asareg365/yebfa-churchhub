rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email.lower() == "asareg365@gmail.com" || 
         request.auth.token.email.lower() == "frankyeb@gmail.com");
    }
    
    function getChurch(churchId) {
      return get(/databases/$(database)/documents/churches/$(churchId)).data;
    }
    
    function isChurchAdmin(churchId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/churches/$(churchId)) && 
         request.auth.token.email.lower() in get(/databases/$(database)/documents/churches/$(churchId)).data.adminEmails) || 
        isSuperAdmin()
      );
    }

    // Churches collection
    match /churches/{churchId} {
      // Allow public reading for discovery, find-ministry, and onboarding
      allow get, list: if true;
      
      // Writing restricted to authorized admins or super admins
      allow update: if isAuthenticated() && (request.auth.token.email.lower() in resource.data.adminEmails || isSuperAdmin());
      allow delete: if isSuperAdmin();
      
      // Allow creation for new ministry onboarding
      allow create: if isAuthenticated();
      
      // All subcollections within a church
      match /{allSubcollections=**} {
        allow read, write: if isChurchAdmin(churchId);
      }
    }
    
    // SMS Ledger - Immutable audit trail
    match /smsLedger/{ledgerId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/smsLedger/$(ledgerId)) && 
         isChurchAdmin(get(/databases/$(database)/documents/smsLedger/$(ledgerId)).data.churchId))
      );
      allow write: if isSuperAdmin();
    }
    
    // SMS Queue & Locks (System Internal)
    match /smsQueue/{messageId} {
      allow read, write: if isSuperAdmin();
    }
    match /smsLocks/{churchId} {
      allow read, write: if isSuperAdmin();
    }
  }
}
